{
  "name": "fetcher",
  "version": "0.0.0",
  "type": "module",
  "description": "Fetcher with interceptors.",
  "keywords": [
    "fetcher",
    "fetch",
    "xhr",
    "jsonp",
    "http-client",
    "request",
    "response"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justnewbee/fetcher.git"
  },
  "homepage": "https://github.com/justnewbee/fetcher",
  "bugs": "https://github.com/justnewbee/fetcher/issues",
  "author": {
    "name": "Jianchun Wang",
    "email": "justnewbee@gmail.com"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@kcuf/eslint-config": "^0.6.6",
    "@kcuf/markdownlint-config": "^0.0.3",
    "@kcuf/npm-package-json-lint-config": "^0.1.0",
    "@kcuf/stylelint-config": "^0.4.0",
    "@kcuf/ts-config": "^0.2.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "commander": "^15.0.0",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lerna": "^10.0.1",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "npm-package-json-lint": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "taze": "^21.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "boot": "pnpm clean && pnpm i --registry https://registry.npmmirror.com",
    "boot:packages": "pnpm -r prepublishOnly",
    "clean:tag:remote": "git tag -l \"@fetchx*/*\" | xargs -n 1 git push --delete origin",
    "clean:tag:local": "git tag -l \"@fetchx*/*\" | xargs -n 1 git tag -d",
    "lint": "eslint packages*/*/src/ --ext js,ts,tsx",
    "lint:style": "stylelint \"**/src/**/*.{css,less,ts,tsx}\"",
    "lint:md": "markdownlint-cli2 **/*.md !node_modules",
    "lint:pkg": "pnpm -r --include-workspace-root exec npmPkgJsonLint .",
    "taze": "taze -r",
    "knip": "knip",
    "lerna:publish": "lerna publish",
    "lerna:publish:patch": "lerna publish patch",
    "lerna:publish:minor": "lerna publish minor",
    "lerna:publish:canary": "lerna publish --npm-tag=canary --canary=canary"
  }
}
